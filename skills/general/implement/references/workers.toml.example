# Example worker roster for ~/.magito/workers.toml (machine-local, never synced).
# Uncomment the entries for the tools installed on this machine, then run
# `python3 <skills>/implement/scripts/worker.py probe <name>` for each one.
# Each entry pins one model. A different model means a separate entry with its own name.
# Keep every top-level key, such as `reviewers`, above the first [workers.*] table.

# Ranked reviewers: tried in this order, then every other worker in file order.
# A reviewer must pass a different family than the writer and answer its probe.
# reviewers = ["codex", "cursor-grok", "gemini", "omp"]

# Thrifty mode: when true, builds and reviews use only workers whose tier is "cheap".
# The environment variable MAGITO_THRIFTY set to 1 or 0 overrides this line for one session.
# thrifty = true

# gpt-6-sol and gpt-6-astra are in ~/.codex/models_cache.json, and both accept effort
# levels from low to ultra. Sol at medium effort is
# the default here: strong, and far cheaper than Astra. `-c model_reasoning_effort=<level>`
# sets the effort for one run. For Astra, copy this entry as `codex-astra`, point its model
# at gpt-6-astra, and use it only when a review needs the strongest model.
# [workers.codex]
# cmd = "codex exec --sandbox workspace-write --ephemeral -m {model} -c model_reasoning_effort=medium -C {cwd} {brief}"
# model = "gpt-6-sol"
# family = "openai"
# tier = "strong"

# `claude --help` lists `opus` as a model alias and shows --model, --permission-mode, and
# --effort (low, medium, high, xhigh, max). Change `medium` to raise or lower the effort.
# The `fable` alias names Anthropic's higher, costlier tier; copy this entry as
# `claude-fable` and set its model to the `fable` alias to use it.
# [workers.claude]
# cmd = "env -u CLAUDECODE claude -p --permission-mode bypassPermissions --model {model} --effort medium {brief}"
# model = "opus"
# family = "anthropic"
# tier = "strong"

# unverified: Gemini CLI has no model list command. The id below is the newest
# pro model its bundle names. Check with `gemini -m <id> -p "Reply OK"`.
# [workers.gemini]
# cmd = "gemini --skip-trust --approval-mode yolo --model {model} --include-directories {cwd} -p {brief}"
# model = "gemini-3.1-pro-preview"
# family = "google"
# tier = "strong"
# requires_env = ["GOOGLE_CLOUD_PROJECT"]
# An `env` table sets plain variables for this worker alone. Never put a secret here: the
# roster is a plain file on disk. An API key goes in the environment the worker starts from (for zsh, ~/.zshenv) or in the tool's own login.
# [workers.gemini.env]
# GOOGLE_CLOUD_PROJECT = "your-project-id"

# Cursor entries take their family from the pinned model, not from the tool.
# All Cursor entries are review-only: `--mode ask` keeps the agent read-only, so they
# cannot build. For a build worker, copy an entry under a new name and replace
# `--mode ask` with `--force`.
# Cursor's CLI has no effort flag. The effort is part of the model id, as a suffix such as
# `-medium`, `-high`, `-thinking-high`, or `-extra-high`. `agent --list-models` prints the
# exact ids. Older CLI versions ignore that suffix, so update the CLI first.
# unverified: Cursor's `agent` CLI is not installed on the machine that wrote this file.
# The flags follow https://cursor.com/docs/cli/reference/parameters. Confirm them with
# `agent --help`.

# OpenAI stops providing models to Cursor, so GPT-6 never reaches Cursor, and this entry
# stops working once that cutoff passes (see History at the end of this file). Prefer
# `cursor-grok` below for a non-Anthropic reviewer on a Cursor-only machine.
# [workers.cursor-openai]
# cmd = "agent -p --mode ask --model {model} {brief}"
# model = "gpt-5.6-sol-medium"
# family = "openai"
# tier = "strong"

# unverified: xAI's Grok models stay in Cursor after the OpenAI cutoff. The model value
# below is a deliberate placeholder: replace it with the Grok id at the effort you want,
# as `agent --list-models` prints it, before uncommenting.
# [workers.cursor-grok]
# cmd = "agent -p --mode ask --model {model} {brief}"
# model = "REPLACE-with-grok-id-from-agent-list-models"
# family = "xai"
# tier = "strong"

# unverified: Cursor lists Claude Opus and Fable models, but its docs give no CLI id. The
# model value below is a deliberate placeholder: replace it with the Opus 5.5 id at the
# effort you want, as `agent --list-models` prints it, before uncommenting. This entry is
# the same family as Claude Code, so it cannot review work that Claude built.
# [workers.cursor-anthropic]
# cmd = "agent -p --mode ask --model {model} {brief}"
# model = "REPLACE-with-opus-5.5-id-from-agent-models"
# family = "anthropic"
# tier = "strong"

# `omp models find kimi-k3` lists moonshotai/kimi-k3 under openrouter.
# The family comes from the pinned model (moonshot), not from omp.
# [workers.omp]
# cmd = "omp -p --no-session --no-skills --approval-mode yolo --max-time 900 --cwd {cwd} --model {model} {brief}"
# model = "openrouter/moonshotai/kimi-k3"
# family = "moonshot"
# tier = "strong"

# Cheap entries for thrifty mode. Each one pins a low-cost model of the same tool.

# gpt-6-luna is in ~/.codex/models_cache.json.
# [workers.codex-cheap]
# cmd = "codex exec --sandbox workspace-write --ephemeral -m {model} -C {cwd} {brief}"
# model = "gpt-6-luna"
# family = "openai"
# tier = "cheap"

# `claude -p --model haiku` answers a probe. `haiku` is Claude's
# cheapest alias; `claude --help` does not list it among its examples.
# [workers.claude-cheap]
# cmd = "env -u CLAUDECODE claude -p --permission-mode bypassPermissions --model {model} {brief}"
# model = "haiku"
# family = "anthropic"
# tier = "cheap"

# `omp models find deepseek-v4-flash` lists deepseek/deepseek-v4-flash under openrouter.
# [workers.omp-cheap]
# cmd = "omp -p --no-session --no-skills --approval-mode yolo --max-time 900 --cwd {cwd} --model {model} {brief}"
# model = "openrouter/deepseek/deepseek-v4-flash"
# family = "deepseek"
# tier = "cheap"

# unverified: Gemini CLI has no model list command. gemini-3.5-flash is named in the
# Gemini CLI bundle. Check with `gemini -m <id> -p "Reply OK"`.
# [workers.gemini-cheap]
# cmd = "gemini --skip-trust --approval-mode yolo --model {model} --include-directories {cwd} -p {brief}"
# model = "gemini-3.5-flash"
# family = "google"
# tier = "cheap"
# requires_env = ["GOOGLE_CLOUD_PROJECT"]

# unverified: check with `agent models`. Cursor's `agent` CLI is not installed on the
# machine that wrote this file, so no cheap model id is known. The model value below is a
# deliberate placeholder, not an id. Replace it before uncommenting. This entry is
# review-only, like the other Cursor entries.
# [workers.cursor-cheap]
# cmd = "agent -p --mode ask --model {model} {brief}"
# model = "REPLACE-with-cheap-id-from-agent-models"
# family = "REPLACE-with-the-family-of-that-model"
# tier = "cheap"

# History (verified on 2026-09-29)
# - codex 0.158: gpt-6-sol, gpt-6-astra, and gpt-6-luna are in ~/.codex/models_cache.json.
# - claude 2.1.284: `claude --help` lists the `opus` alias and the --model,
#   --permission-mode, and --effort flags. A probe with `--model opus --effort medium`
#   answered, and `claude -p --model haiku` answered.
# - gemini-cli 0.46.0: flags checked against `gemini --help`. Gemini 3.1 Pro is Google's
#   top Pro model, and 3.5 Pro is unreleased.
# - Cursor: before 2026-08-27 the CLI ignored the effort suffix in a model id.
# - Cursor: OpenAI stops providing models to Cursor on 2026-11-12, after SpaceX acquired
#   Cursor, and ships no new models there before then:
#   https://openai.com/index/our-decision-on-cursor-following-its-acquisition-by-spacex/
# - Cursor lists Claude Opus 5.5 and Fable 5.1, but its docs give no CLI id.
# - omp: `omp models find` lists moonshotai/kimi-k3 and deepseek/deepseek-v4-flash under
#   openrouter.
